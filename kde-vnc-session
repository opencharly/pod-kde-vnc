#!/bin/sh
# kde-vnc-session — run a full KDE Plasma session NESTED inside the pod's headless sway,
# as one window that sway's kiosk rule (kde-vnc.conf) makes fullscreen. wayvnc serves
# sway, so a VNC client sees Plasma, hardware-accelerated on the pod's GPU (KWin renders
# through EGL on whatever GPU sway's buffers come from).
#
# Knobs (all optional):
#   KDE_NESTED_HOST_DISPLAY  the host compositor's socket (default wayland-0, sway's)
#   KDE_NESTED_SOCKET        the socket the nested KWin serves (default wayland-kde —
#                            pod-sway's sway itself serves wayland-1 behind its wayland-0
#                            symlink, so a numbered default would collide)
#   RESOLUTION               WxH of the nested session (default 1920x1080, = sway's output)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
HOST="${KDE_NESTED_HOST_DISPLAY:-wayland-0}"
SOCK="${KDE_NESTED_SOCKET:-wayland-kde}"
RES="${RESOLUTION:-1920x1080}"
WIDTH="${RES%x*}"
HEIGHT="${RES#*x}"

HOST_SOCKET="$XDG_RUNTIME_DIR/$HOST"
TIMEOUT=60
ELAPSED=0
echo "kde-vnc-session: waiting for the host compositor at $HOST_SOCKET..."
while [ ! -e "$HOST_SOCKET" ] && [ "$ELAPSED" -lt "$TIMEOUT" ]; do
    sleep 1
    ELAPSED=$((ELAPSED + 1))
done
if [ ! -e "$HOST_SOCKET" ]; then
    echo "kde-vnc-session: host socket $HOST_SOCKET not ready after ${TIMEOUT}s" >&2
    exit 1
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
# Without a session manager nothing sets this, and kdotool (the wl verb's KWin window
# backend) refuses to run: "Unsupported KDE version. kdotool only supports KDE Plasma 6."
export KDE_SESSION_VERSION=6
export XCURSOR_THEME=breeze_cursors
export XCURSOR_SIZE=24
export XKB_DEFAULT_LAYOUT="${XKB_DEFAULT_LAYOUT:-us}"

# A restarted session leaves the previous socket and lock behind.
rm -f "$XDG_RUNTIME_DIR/$SOCK" "$XDG_RUNTIME_DIR/$SOCK.lock"

# KWin is launched DIRECTLY as a nested compositor (`--wayland-display` = the host it
# renders into, `--socket` = the one it serves), not via startplasma-wayland: without a
# systemd session that falls back to a headless KWin nobody sees. It runs without its
# cap_sys_nice file capability (stripped at build) because the pod's no-new-privileges
# refuses to exec a file-capability binary.
WAYLAND_DISPLAY="$HOST" kwin_wayland --wayland-display "$HOST" --socket "$SOCK" --xwayland \
    --width "$WIDTH" --height "$HEIGHT" &
KWIN_PID=$!

ELAPSED=0
while [ ! -e "$XDG_RUNTIME_DIR/$SOCK" ] && [ "$ELAPSED" -lt "$TIMEOUT" ]; do
    sleep 1
    ELAPSED=$((ELAPSED + 1))
done
if [ -e "$XDG_RUNTIME_DIR/$SOCK" ]; then
    echo "kde-vnc-session: KWin serves $SOCK, starting plasmashell"
    WAYLAND_DISPLAY="$SOCK" plasmashell &
else
    echo "kde-vnc-session: KWin never served $SOCK in ${TIMEOUT}s; plasmashell not started" >&2
fi

# The session lives as long as KWin does; supervisord restarts the whole session.
wait "$KWIN_PID"
